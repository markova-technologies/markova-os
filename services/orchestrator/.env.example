# =============================================================================
# Markova Orchestrator Environment Configuration
# =============================================================================

# Server & Scalability Settings
PORT=10000
WEB_CONCURRENCY=1              # 1 for Render Free tier; scale to 2 or 4 on Starter/Standard
DB_POOL_MIN_SIZE=1             # 1 for Free tier; scale to 5 or 10 on higher plans
DB_POOL_MAX_SIZE=5             # 5 for Free tier; scale to 15 or 25 on higher plans
ALLOWED_ORIGINS=https://markova-os-client-dashboard.vercel.app,https://markova-os-admin.vercel.app,http://localhost:5173
ORCHESTRATOR_BASE_URL=https://markova-orchestrator.onrender.com

# Core Infrastructure
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
SERVICE_AUTH_SECRET=your-secure-internal-service-secret
JWT_SECRET=your-supabase-or-gateway-jwt-secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Providers & Voice Synthesis
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
HASAB_API_KEY=...

# Telephony (Twilio / FreeSWITCH)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1234567890

# On-prem vLLM Configuration (DATA_RESIDENCY_MODE=true)
DATA_RESIDENCY_MODE=false
VLLM_ENDPOINT_URL=http://vllm-server:8000/v1
VLLM_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
VLLM_API_KEY=EMPTY
