# Client dashboard — points at the single Markova API gateway (openapi.yaml).
# Dev: leave empty; Vite proxies /v1 -> http://localhost:8000 (see vite.config.js).
# Prod: set to the deployed gateway origin, e.g. https://api.markova.io
VITE_API_URL=

# Docs site for landing nav / footer links.
# Dev: defaults to http://localhost:3002 when unset.
# Prod: REQUIRED for Docs links — set full origin (e.g. https://docs.markova.et).
# Do not leave as /docs on this app; that path is not served and redirects to /.
VITE_DOCS_URL=
