# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://markova:CHANGE_ME@localhost:5432/markova_db
POSTGRES_USER=markova
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=markova_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security (REQUIRED — set before first run) ──────────────────────────────
# NOTE: JWT signing uses RS256 asymmetric keys (auto-generated in services/auth-service/keys/).
# No JWT_SECRET needed.

# 32-byte (64-char hex) AES master key for the Secret Vault.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=CHANGE_ME_64_HEX_CHARS

# Shared secret for service-to-service HMAC authentication.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_AUTH_SECRET=CHANGE_ME_64_HEX_CHARS

# Playground dashboard API key (ai call center). REQUIRED — no default.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_API_KEY=CHANGE_ME_SECURE_RANDOM

# FreeSWITCH ESL password (playground barge-in). REQUIRED when using SIP/ESL — no default.
FREESWITCH_ESL_PASSWORD=CHANGE_ME
FREESWITCH_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021

# ─── Port Assignments ────────────────────────────────────────────────────────
# Auth Service
PORT=5001
# Tenant Service:   5002
# Agent Builder:    5003
# Tool Engine:      5004
# Connector Hub:    5005
# Knowledge:        5006
# Orchestrator:     6000
# API Gateway:      8000

# ─── LLM Keys (fallback defaults — per-company keys stored in DB) ────────────
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Voice / STT Keys ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_REGION=eastus

# ─── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Billing webhook HMAC secret (required). Sign body with HMAC-SHA256.
# Header: x-billing-signature: sha256=<hex>  (or Stripe-style t=...,v1=<hex>)
BILLING_WEBHOOK_SECRET=CHANGE_ME_64_HEX_CHARS
