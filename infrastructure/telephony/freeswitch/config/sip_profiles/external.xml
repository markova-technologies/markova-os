<include>
  <!-- 
      Ethio Telecom SIP Trunk Configuration 
      This file goes in /etc/freeswitch/sip_profiles/external/ethiotelecom.xml
  -->
  <gateway name="ethiotelecom">
    <!-- Ethio Telecom proxy usually sip.ethiotelecom.et -->
    <param name="proxy" value="sip.ethiotelecom.et"/>
    <param name="realm" value="sip.ethiotelecom.et"/>
    
    <!-- Your Short Code or SIP Username -->
    <param name="username" value="YOUR_SIP_USERNAME"/>
    <param name="password" value="YOUR_SIP_PASSWORD"/>
    
    <!-- Register with the carrier -->
    <param name="register" value="true"/>
    
    <!-- Send keep-alives to keep NAT open -->
    <param name="register-transport" value="udp"/>
    <param name="retry-seconds" value="30"/>
    <param name="ping" value="25"/>
    
    <!-- Codec preferences: Ethio Telecom usually supports G.711 (PCMA/PCMU) and G.729 -->
    <param name="caller-id-in-from" value="true"/>
    <param name="extension" value="YOUR_SHORTCODE"/>
    <param name="extension-in-contact" value="true"/>
    
    <variables>
        <variable name="verbose_sdp" value="true"/>
    </variables>
  </gateway>
</include>
